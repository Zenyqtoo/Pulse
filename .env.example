# Copy to .env and fill in. Never commit .env.

APP_NAME=City Alert
CITY_NAME=Павлодар

# --- Security (change all of these) ---
SECRET_KEY=replace-with-64-random-characters
AUTHOR_HASH_SALT=replace-with-another-random-string
SEED_ADMIN_PASSWORD=admin123
SEED_OPERATOR_PASSWORD=operator123
SEED_VIEWER_PASSWORD=viewer123
POSTGRES_PASSWORD=pulse
# Only for local development without Docker:
DATABASE_URL=postgresql+psycopg://pulse:pulse@localhost:5432/pulse
CORS_ORIGINS=http://localhost:5173

# --- Claude API (needed for LLM analysis; without it a labelled rules fallback is used) ---
ANTHROPIC_API_KEY=
LLM_MODEL_ENRICH=claude-haiku-5-5
LLM_MODEL_SUMMARY=claude-sonnet-5-5
LLM_PARALLELISM=8
REVIEW_CONFIDENCE_THRESHOLD=0.6

# Experimental local classifier (archived, disabled by default).
# Start its separate service manually before opting in; see docs/OPTIONAL_LOCAL_MODEL.md.
LOCAL_MODEL_ENABLED=false
LOCAL_MODEL_URL=http://127.0.0.1:8012
LOCAL_MODEL_TIMEOUT_S=10

# --- Telegram ---
# Bot for Direct messages (create with @BotFather). Long polling, no public URL needed.
TELEGRAM_BOT_TOKEN=
# Chat id where critical-priority alerts are sent (operators' group or your own chat id)
TELEGRAM_ALERT_CHAT_ID=
# Client API for comments under channel posts and public chats (my.telegram.org)
TELEGRAM_API_ID=0
TELEGRAM_API_HASH=

# --- Public URL of this deployment (used as OAuth redirect for Instagram and Threads) ---
PUBLIC_BASE_URL=http://localhost:8000

# --- Instagram (Meta app with product "Instagram API" → "API setup with Instagram business login") ---
# Redirect URI to register in the Meta app: {PUBLIC_BASE_URL}/api/connect/instagram/callback
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
INSTAGRAM_SCOPES=instagram_business_basic,instagram_business_manage_comments,instagram_business_manage_messages
# Optional instead of the "Connect" button: a long-lived token (+ IG user id for Facebook Login tokens)
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_USER_ID=
# graph.instagram.com (Instagram Login) or graph.facebook.com (Facebook Login: business discovery, hashtags)
INSTAGRAM_API_HOST=graph.instagram.com
META_GRAPH_VERSION=v26.0

# --- Threads (Meta app with product "Threads API") ---
# Redirect URI to register: {PUBLIC_BASE_URL}/api/connect/threads/callback
THREADS_APP_ID=
THREADS_APP_SECRET=
THREADS_SCOPES=threads_basic,threads_read_replies,threads_keyword_search
THREADS_ACCESS_TOKEN=
THREADS_API_HOST=graph.threads.com

# --- Clustering ---
# auto: sentence-transformers if installed, else TF-IDF
EMBEDDING_BACKEND=auto
EMBEDDING_MODEL=intfloat/multilingual-e5-small
CLUSTER_THRESHOLD=0.55

# --- Scheduling and retention ---
SCHEDULER_ENABLED=true
COLLECT_INTERVAL_MINUTES=60
BOT_POLL_SECONDS=20
DIRECT_RETENTION_DAYS=90
